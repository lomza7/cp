---
import { Icon } from 'astro-icon/components';
import Base from '../layouts/Base.astro';
import Bouton from '../components/Bouton.astro';
import Tampon from '../components/Tampon.astro';
import Horaires from '../components/Horaires.astro';
import Photo from '../components/Photo.astro';
import AvisGoogle from '../components/AvisGoogle.astro';
import { site, contact, address, team, quoteForms } from '../config/site.ts';

const paul = team.find((m) => m.id === 'paul')!;
const calvin = team.find((m) => m.id === 'calvin')!;

/*
  Les intitulés reprennent ceux de la vitrine de l'agence, photographiée le
  28 août 2026 : ce sont les mots que le cabinet a lui-même choisi d'afficher
  dans la rue.
*/
const assurances = [
  { label: 'Auto et moto, résilié, malussé, jeune permis', href: '/assurances/auto-moto' },
  { label: 'Habitation, locataire, propriétaire, PNO', href: '/assurances/habitation' },
  { label: 'Professionnels, RC pro, décennale', href: '/assurances/professionnels' },
  { label: 'Mutuelle, animaux, camping-car, voyage', href: '/assurances/autres' },
];

const credits = [
  { label: 'Prêt immobilier', href: '/credits/immobilier' },
  { label: 'Rachat, regroupement, renégociation', href: '/credits/rachat-regroupement' },
  { label: 'Assurance emprunteur', href: '/assurance-emprunteur' },
];
---

<Base
  title="Courtier en assurances et crédits à Montereau-Fault-Yonne | CP SOLUTIONS"
  description="Cabinet de courtage à Montereau-Fault-Yonne. Assurances auto, habitation, professionnels, y compris après résiliation ou malus. Prêt immobilier, rachat de crédits. Appelez le 01 64 24 83 45."
  path="/"
>
  <!--
    Le hero repose sur la devanture : le visiteur doit voir qu'il y a une vraie
    porte à pousser. C'est l'argument que ni un comparateur en ligne ni une
    plateforme ne peuvent copier.
  -->
  <section class="hero">
    <div class="conteneur hero__grille">
      <div class="hero__texte">
        <h1>Assurances et crédits, à Montereau.</h1>
        <p class="hero__accroche">
          Deux courtiers indépendants, rue Jean Jaurès, du lundi au samedi.
          On compare les compagnies et les banques à votre place.
        </p>

        <div class="hero__actions">
          <Bouton href={contact.phoneHref} variante="encre" taille="grand" icone="ph:phone-fill">
            Appeler le {contact.phoneDisplay}
          </Bouton>
          <Bouton href="/credits#simulateur" variante="lien">
            Simuler mon budget d'achat
          </Bouton>
        </div>

        <!-- La note Google entre dans le hero : c'est la preuve la plus forte du cabinet. -->
        <AvisGoogle variante="compact" class="hero__preuve" />
      </div>

      <Photo
        class="hero__visuel"
        nom="devanture"
        alt="La devanture de CP SOLUTIONS au 35 rue Jean Jaurès à Montereau-Fault-Yonne : enseigne bleue au logo de deux mains qui se serrent, vitrine listant les assurances et les crédits proposés, porte d'entrée vitrée."
        attente="la devanture du 35 rue Jean Jaurès"
        ratio="4 / 3"
        prioritaire
        sizes="(min-width: 64rem) 50vw, 100vw"
      />
    </div>
  </section>

  <!--
    Les deux métiers, en vis-à-vis. C'est la seule section du site où l'orange et
    le bleu ont le même poids : le visiteur doit comprendre en une seconde qu'il
    y a deux métiers, et à qui il va parler.
  -->
  <section class="duo" aria-labelledby="duo-titre">
    <h2 id="duo-titre" class="lecteur-seul">Nos deux métiers</h2>

    <div class="duo__bloc duo__bloc--assurances" data-metier="assurances">
      <div class="duo__interieur">
        <p class="duo__qui">
          Assurances · <a href="/le-cabinet#paul">{paul.firstName} {paul.lastName}</a>
        </p>
        <h3>Assuré, même quand les autres disent non.</h3>
        <ul>
          {
            assurances.map((item) => (
              <li>
                <a href={item.href}>
                  <span>{item.label}</span>
                  <Icon name="ph:arrow-right" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
        <Bouton href="/assurances" variante="contour">Toutes les assurances</Bouton>
      </div>
    </div>

    <div class="duo__bloc duo__bloc--credits" data-metier="credits" data-fond="bleu">
      <div class="duo__interieur">
        <p class="duo__qui">
          Crédits · <a href="/le-cabinet#calvin">{calvin.firstName} {calvin.lastName}</a>
        </p>
        <h3>Du compromis aux clés, en dix étapes.</h3>
        <ul>
          {
            credits.map((item) => (
              <li>
                <a href={item.href}>
                  <span>{item.label}</span>
                  <Icon name="ph:arrow-right" aria-hidden="true" />
                </a>
              </li>
            ))
          }
        </ul>
        <Bouton href="/credits" variante="contour">Tous les crédits</Bouton>
      </div>
    </div>
  </section>

  <!-- L'angle qui différencie vraiment le cabinet. -->
  <section class="refus section" data-metier="assurances">
    <div class="conteneur refus__grille">
      <div>
        <div class="refus__entete">
          <h2>Résilié, malussé, permis annulé ?</h2>
          <Tampon couleur="orange" angle={-6}>Accepté</Tampon>
        </div>
        <p class="mesure">
          Une résiliation, une perte de permis, trop d'accidents ou du malus : ce sont
          les dossiers que les compagnies refusent en ligne, et ceux que nous traitons
          le plus souvent. Nous savons lesquelles acceptent, à quelles conditions et à
          quel prix.
        </p>
        <p class="mesure refus__agira">
          Inutile de cacher votre historique : il est enregistré à l'AGIRA, tous les
          assureurs y ont accès. Dites-nous la vérité, nous chercherons la solution.
        </p>
        <div class="refus__actions">
          <Bouton href={quoteForms.auto} variante="accent" externe icone="ph:file-text">
            Devis auto en ligne
          </Bouton>
          <Bouton href={contact.phoneHref} variante="contour" icone="ph:phone-fill">
            Ou appelez-nous
          </Bouton>
        </div>
      </div>
    </div>
  </section>

  <!-- Les deux associés : à qui vous allez parler, avec leurs propres mots. -->
  <section class="associes section">
    <div class="conteneur">
      <h2>Deux associés, deux métiers</h2>
      <p class="associes__intro mesure">
        Contrairement à un agent lié à une seule compagnie, nous comparons pour vous.
        Notre rôle est de défendre vos intérêts, pas ceux d'un assureur ou d'une banque.
      </p>

      <div class="associes__grille">
        <article class="associe" data-metier="assurances">
          <Photo
            class="associe__photo"
            nom="paul"
            alt={`${paul.firstName} ${paul.lastName} à son bureau, devant un ordinateur portable, dans l'agence de Montereau-Fault-Yonne.`}
            attente={`portrait de ${paul.firstName} ${paul.lastName}`}
            ratio="4 / 5"
            sizes="(min-width: 48rem) 24rem, 100vw"
          />
          <h3 id={paul.id}>{paul.firstName} {paul.lastName}</h3>
          <p class="associe__role libelle">{paul.role}</p>
          <blockquote class="associe__citation">{paul.quote}</blockquote>
        </article>

        <article class="associe" data-metier="credits">
          <Photo
            class="associe__photo"
            nom="calvin"
            alt={`${calvin.firstName} ${calvin.lastName} dans son bureau à l'agence de Montereau-Fault-Yonne, les mains posées sur la table.`}
            attente={`portrait de ${calvin.firstName} ${calvin.lastName}`}
            ratio="4 / 5"
            sizes="(min-width: 48rem) 24rem, 100vw"
          />
          <h3 id={calvin.id}>{calvin.firstName} {calvin.lastName}</h3>
          <p class="associe__role libelle">{calvin.role}</p>
          <blockquote class="associe__citation">{calvin.quote}</blockquote>
        </article>
      </div>
    </div>
  </section>

  <AvisGoogle />

  <!-- L'agence : la preuve qu'ils existent physiquement. -->
  <section class="agence section">
    <div class="conteneur agence__grille">
      <div>
        <h2>Poussez la porte</h2>
        <p class="mesure">
          Chez nous le téléphone existe, mais vous pouvez aussi venir. L'agence est au
          {' '}{address.street}, à {address.city}, ouverte six jours sur sept, avec ou
          sans rendez-vous.
        </p>
        <div class="agence__actions">
          <Bouton href="/agence-montereau" variante="contour" icone="ph:map-pin">
            Voir l'agence
          </Bouton>
          <Bouton href={contact.calendly} variante="lien" externe>
            Prendre rendez-vous
          </Bouton>
        </div>
      </div>
      <div class="agence__horaires">
        <h3 class="libelle">Horaires d'ouverture</h3>
        <Horaires />
      </div>
    </div>
  </section>

  <!-- Dernière chance de convertir : le numéro, en grand. -->
  <section class="appel" data-fond="sombre">
    <div class="conteneur appel__interieur">
      <div>
        <h2>Un doute ? Appelez, on répond.</h2>
        <p>Un courtier au bout du fil, pas un serveur vocal. {site.slogan}.</p>
      </div>
      <div class="appel__actions">
        <a class="appel__numero" href={contact.phoneHref}>
          <Icon name="ph:phone-fill" aria-hidden="true" />
          {contact.phoneDisplay}
        </a>
        <a class="appel__rappel" href="/contact">Ou demandez à être rappelé</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---- Hero ---- */
  .hero {
    padding-block: var(--e-8) var(--e-12);
    border-bottom: var(--filet-fort);
  }

  .hero__grille {
    display: grid;
    gap: var(--e-8);
  }

  /*
    Échelle propre au hero : le titre partage la largeur avec la devanture, il
    ne peut donc pas prendre les 64 px de --t-1 sans passer à quatre lignes.
  */
  .hero h1 {
    font-size: clamp(2.375rem, 1.7rem + 3vw, 3.25rem);
    max-width: 22ch;
  }

  .hero__accroche {
    margin-top: var(--e-4);
    max-width: 38ch;
    font-size: clamp(1.0625rem, 1rem + 0.5vw, 1.1875rem);
    color: var(--encre-2);
  }

  .hero__actions {
    margin-top: var(--e-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-6);
  }

  .hero :global(.hero__preuve) {
    margin-top: var(--e-8);
  }

  .hero__visuel {
    width: 100%;
  }

  /* ---- Les deux métiers ---- */
  .duo {
    display: grid;
    border-bottom: var(--filet-fort);
  }

  .duo__bloc {
    padding-block: var(--section-y);
  }

  .duo__bloc--assurances {
    background: var(--orange);
    color: var(--encre);
  }

  .duo__bloc--credits {
    background: var(--bleu);
    color: var(--papier);
  }

  .duo__interieur {
    width: 100%;
    max-width: calc(var(--conteneur) / 2);
    margin-inline: auto;
    padding-inline: var(--gouttiere);
  }

  .duo__qui {
    font-family: var(--f-donnee);
    font-size: var(--t-libelle);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .duo__qui a {
    display: inline-block;
    padding-block: var(--e-2);
    color: inherit;
    text-decoration-thickness: 1px;
  }

  .duo__bloc h3 {
    margin-top: var(--e-2);
    font-size: var(--t-2);
    max-width: 22ch;
    font-variation-settings: 'opsz' 72;
  }

  .duo__bloc ul {
    margin-top: var(--e-6);
  }

  .duo__bloc li {
    border-top: 1px solid rgb(27 27 24 / 0.2);
  }

  .duo__bloc--credits li {
    border-top-color: rgb(243 242 237 / 0.3);
  }

  .duo__bloc li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-4);
    min-height: var(--touche);
    padding-block: var(--e-2);
    color: inherit;
    font-weight: 700;
    text-decoration: none;
  }

  .duo__bloc li a:hover span {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 3px;
  }

  .duo__bloc li :global(svg) {
    width: 1.125rem;
    height: 1.125rem;
    flex: none;
  }

  .duo__bloc :global(.bouton) {
    margin-top: var(--e-6);
  }

  .duo__bloc--credits :global(.bouton--contour) {
    color: var(--papier);
  }

  .duo__bloc--credits :global(.bouton--contour:hover) {
    background: var(--papier);
    color: var(--bleu);
  }

  .duo__bloc--assurances :global(.bouton--contour:hover) {
    background: var(--encre);
    color: var(--orange);
  }

  /* ---- Résiliés ---- */
  .refus {
    background: var(--orange-pale);
    border-bottom: var(--filet-fort);
  }

  .refus__grille {
    display: grid;
    gap: var(--e-8);
  }

  /*
    Le tampon répond à la question du titre : il reste avec lui, et passe à la
    ligne sous le titre quand la place manque.
  */
  .refus__entete {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4) var(--e-6);
  }

  .refus__entete + p {
    margin-top: var(--e-4);
  }

  .refus__agira {
    margin-top: var(--e-4);
    font-size: var(--t-small);
    color: var(--encre-2);
  }

  .refus__actions {
    margin-top: var(--e-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  /* ---- Associés ---- */
  .associes__intro {
    margin-top: var(--e-4);
    color: var(--encre-2);
  }

  .associes__grille {
    margin-top: var(--e-8);
    display: grid;
    gap: var(--e-8);
  }

  .associe :global(.associe__photo) {
    margin-bottom: var(--e-4);
  }

  .associe h3 {
    font-size: var(--t-3);
  }

  .associe__role {
    margin-top: var(--e-1);
    color: var(--accent);
  }

  /* Le bleu passe en texte, l'orange non : il ne tient pas le contraste. */
  .associe[data-metier='assurances'] .associe__role {
    color: var(--encre-2);
  }

  .associe__citation {
    margin-top: var(--e-3);
    padding-left: var(--e-4);
    border-left: 3px solid var(--accent);
    font-size: var(--t-small);
    color: var(--encre-2);
  }

  /* ---- Agence ---- */
  .agence {
    border-top: var(--filet);
  }

  .agence__grille {
    display: grid;
    gap: var(--e-8);
  }

  .agence p {
    margin-top: var(--e-4);
  }

  .agence__actions {
    margin-top: var(--e-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--e-4);
  }

  .agence__horaires h3 {
    padding-bottom: var(--e-2);
    border-bottom: var(--filet);
    margin-bottom: var(--e-2);
  }

  /* ---- Appel final ---- */
  .appel {
    background: var(--encre);
    color: var(--papier);
    padding-block: var(--section-y);
  }

  .appel__interieur {
    display: grid;
    gap: var(--e-8);
  }

  .appel h2 {
    max-width: 24ch;
  }

  .appel p {
    margin-top: var(--e-3);
    color: rgb(243 242 237 / 0.75);
  }

  .appel__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .appel__numero {
    display: inline-flex;
    align-items: center;
    gap: var(--e-3);
    padding: var(--e-4) var(--e-6);
    background: var(--orange);
    color: var(--encre);
    border-radius: var(--rayon);
    font-family: var(--f-donnee);
    font-size: clamp(1.25rem, 1rem + 1.6vw, 1.75rem);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .appel__numero:hover {
    background: var(--orange-fonce);
    color: var(--encre);
  }

  .appel__numero :global(svg) {
    width: 1.125em;
    height: 1.125em;
  }

  .appel__rappel {
    display: inline-flex;
    align-items: center;
    min-height: var(--touche);
    margin-top: var(--e-2);
    color: var(--papier);
    font-weight: 700;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .appel__rappel:hover {
    color: var(--orange);
  }

  /* ---- Points de rupture ---- */
  @media (min-width: 48rem) {
    .duo {
      grid-template-columns: 1fr 1fr;
    }

    .duo__interieur {
      max-width: calc(var(--conteneur) / 2);
      margin-inline: 0;
    }

    .duo__bloc--assurances .duo__interieur {
      margin-left: auto;
      padding-right: var(--e-8);
    }

    .duo__bloc--credits .duo__interieur {
      padding-left: var(--e-8);
    }

    .associes__grille,
    .agence__grille {
      grid-template-columns: 1fr 1fr;
      gap: var(--e-12);
    }

    .appel__interieur {
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: var(--e-12);
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: var(--e-12) var(--e-16);
    }

    /*
      La devanture prend la moitié du hero : c'est le visuel qui fait le travail
      de confiance, pas une illustration d'accompagnement.
    */
    .hero__grille {
      grid-template-columns: 6fr 5fr;
      gap: var(--e-12);
      align-items: center;
    }

    .agence__grille {
      grid-template-columns: 1fr 22rem;
      gap: var(--e-16);
    }

    .associes__grille {
      grid-template-columns: repeat(2, minmax(0, 24rem));
    }
  }
</style>
