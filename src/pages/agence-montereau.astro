---
import Page from '../layouts/Page.astro';
import Photo from '../components/Photo.astro';
import Horaires from '../components/Horaires.astro';
import Bouton from '../components/Bouton.astro';
import AvisGoogle from '../components/AvisGoogle.astro';
import { Icon } from 'astro-icon/components';
import { contact, address, areaServed, site } from '../config/site.ts';
import { localBusiness } from '../lib/schema.ts';

/*
  Page locale : elle sert le référencement de proximité et rassure. Le balisage
  LocalBusiness est déjà posé sur toutes les pages par le layout de base ; on le
  répète ici parce que c'est la page canonique de l'établissement.

  TODO client (QUESTIONS-CLIENT n° 8) : si Nemours est une agence ou une
  permanence réelle, il faudra une page dédiée et une seconde entrée
  LocalBusiness. Aucune mention n'est faite ici en attendant.
*/
---

<Page
  title="Notre agence à Montereau-Fault-Yonne, 35 rue Jean Jaurès"
  description="CP SOLUTIONS, 35 rue Jean Jaurès à Montereau-Fault-Yonne. Ouvert du lundi au samedi, avec ou sans rendez-vous. Horaires, itinéraire, téléphone : 01 64 24 83 45."
  path="/agence-montereau"
  h1="L'agence de Montereau-Fault-Yonne"
  chapeau="Une vraie boutique, une vraie porte, deux courtiers derrière. Vous pouvez appeler, mais vous pouvez aussi passer : c'est souvent plus rapide pour les dossiers compliqués."
  filCourant="Agence de Montereau"
  schema={localBusiness()}
>
  <section class="section conteneur">
    <div class="agence">
      <Photo
        class="agence__photo"
        nom="devanture"
        alt={`La devanture de ${site.name} au ${address.street} à ${address.city} : enseigne bleue au logo de deux mains qui se serrent, vitrine listant les assurances et les crédits, porte d'entrée vitrée.`}
        attente="la devanture du 35 rue Jean Jaurès"
        ratio="4 / 3"
        sizes="(min-width: 64rem) 55vw, 100vw"
      />

      <div class="agence__infos">
        <div class="bloc">
          <h2 class="libelle">Adresse</h2>
          <address>
            {address.street}<br />
            {address.postalCode} {address.city}
          </address>
          <Bouton href={address.mapsUrl} variante="contour" externe icone="ph:map-pin">
            Itinéraire
          </Bouton>
        </div>

        <div class="bloc">
          <h2 class="libelle">Téléphone</h2>
          <p class="bloc__tel">
            <a href={contact.phoneHref}>{contact.phoneDisplay}</a>
          </p>
          <p class="bloc__note">
            Un courtier répond, pas un serveur vocal.
          </p>
        </div>

        <div class="bloc">
          <h2 class="libelle">E-mail</h2>
          <p><a href={`mailto:${contact.email}`}>{contact.email}</a></p>
        </div>

        <div class="bloc">
          <h2 class="libelle">Horaires</h2>
          <Horaires />
          <p class="bloc__note">
            Avec ou sans rendez-vous. Pour être sûr d'avoir quelqu'un de disponible,
            appelez avant de passer ou{' '}
            <a href={contact.calendly} target="_blank" rel="noopener">
              prenez un créneau<span class="lecteur-seul"> (nouvel onglet)</span></a>.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section conteneur venir">
    <h2>Y venir</h2>
    <div class="venir__grille">
      <div>
        <h3>En voiture</h3>
        <p>
          La rue Jean Jaurès est en centre-ville. Stationnement en zone bleue devant
          l'agence, pensez au disque.
        </p>
      </div>
      <div>
        <h3>En transports</h3>
        <p>
          Gare de Montereau à une dizaine de minutes à pied, ligne R du Transilien et
          liaisons régionales.
        </p>
      </div>
      <div>
        <h3>Depuis les alentours</h3>
        <p>
          Nous recevons des clients de {areaServed.filter((z) => z !== address.city).join(', ')}.
          Pour un premier échange, le téléphone évite un déplacement.
        </p>
      </div>
    </div>
  </section>

  <section class="section conteneur zone">
    <h2>Zone desservie</h2>
    <ul>
      {areaServed.map((z) => <li><Icon name="ph:map-pin" aria-hidden="true" />{z}</li>)}
    </ul>
    <p class="zone__note">
      Cette liste correspond à notre zone d'intervention habituelle, pas à une limite :
      un dossier de crédit ou d'assurance se traite très bien à distance.
    </p>
  </section>

  <AvisGoogle />

  <section class="section conteneur final">
    <h2>Passez, ou appelez</h2>
    <div class="final__actions">
      <Bouton href={contact.phoneHref} variante="accent" taille="grand" icone="ph:phone-fill">
        Appeler le {contact.phoneDisplay}
      </Bouton>
      <Bouton href="/contact" variante="contour">Demander un rappel</Bouton>
    </div>
  </section>
</Page>

<style>
  .agence {
    display: grid;
    gap: var(--e-8);
  }

  .agence__infos {
    display: grid;
    gap: var(--e-6);
  }

  .bloc h2 {
    padding-bottom: var(--e-2);
    border-bottom: var(--filet);
    margin-bottom: var(--e-3);
  }

  .bloc address {
    font-style: normal;
    font-family: var(--f-donnee);
    margin-bottom: var(--e-3);
  }

  .bloc__tel a {
    font-family: var(--f-donnee);
    font-size: var(--t-3);
    font-weight: 500;
    color: var(--encre);
    text-decoration-color: var(--orange);
    text-decoration-thickness: 3px;
    font-variant-numeric: tabular-nums;
  }

  .bloc__note {
    margin-top: var(--e-2);
    font-size: var(--t-small);
    color: var(--encre-2);
  }

  .venir {
    border-top: var(--filet-fort);
  }

  .venir__grille {
    margin-top: var(--e-6);
    display: grid;
    gap: var(--e-6);
  }

  .venir h3 {
    font-size: var(--t-4);
    padding-top: var(--e-3);
    border-top: 2px solid var(--encre);
  }

  .venir p {
    margin-top: var(--e-2);
    max-width: 52ch;
    color: var(--encre-2);
  }

  .zone {
    border-top: var(--filet);
  }

  .zone ul {
    margin-top: var(--e-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-3);
  }

  .zone li {
    display: inline-flex;
    align-items: center;
    gap: var(--e-1);
    padding: var(--e-2) var(--e-3);
    border: 1px solid var(--encre);
    border-radius: var(--rayon);
    font-family: var(--f-donnee);
    font-size: var(--t-small);
  }

  .zone :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--encre-2);
  }

  .zone__note {
    margin-top: var(--e-4);
    max-width: 62ch;
    font-size: var(--t-small);
    color: var(--encre-2);
  }

  .final {
    border-top: var(--filet);
  }

  .final__actions {
    margin-top: var(--e-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
  }

  @media (min-width: 64rem) {
    .agence {
      grid-template-columns: 1.3fr 1fr;
      gap: var(--e-16);
    }

    .venir__grille {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--e-8);
    }
  }
</style>
