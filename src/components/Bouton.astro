---
import { Icon } from 'astro-icon/components';

interface Props {
  href?: string;
  /**
   * encre    : action principale, aplat d'encre sur papier
   * accent   : aplat de la couleur du métier courant (orange ou bleu)
   * contour  : action secondaire, filet d'encre
   * lien     : action tertiaire, souligné
   */
  variante?: 'encre' | 'accent' | 'contour' | 'lien';
  taille?: 'normal' | 'grand';
  /** Nom d'une icône Phosphor, ex. « ph:phone-fill ». */
  icone?: string;
  /** Vrai lien externe : nouvel onglet et mention pour les lecteurs d'écran. */
  externe?: boolean;
  type?: 'button' | 'submit';
  pleineLargeur?: boolean;
  class?: string;
  [key: string]: unknown;
}

const {
  href,
  variante = 'encre',
  taille = 'normal',
  icone,
  externe = false,
  type = 'button',
  pleineLargeur = false,
  class: classe,
  ...reste
} = Astro.props;

const Element = href ? 'a' : 'button';
const classes = ['bouton', `bouton--${variante}`, `bouton--${taille}`, pleineLargeur && 'bouton--large', classe]
  .filter(Boolean)
  .join(' ');

const attrsExterne = externe ? { target: '_blank', rel: 'noopener' } : {};
---

<Element
  class={classes}
  href={href}
  type={href ? undefined : type}
  {...attrsExterne}
  {...reste}
>
  {icone && <Icon name={icone} aria-hidden="true" />}
  <span><slot /></span>
  {externe && <span class="lecteur-seul">(nouvel onglet)</span>}
</Element>

<style>
  .bouton {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--e-2);
    min-height: var(--touche);
    padding: var(--e-3) var(--e-6);
    border-radius: var(--rayon);
    border: 2px solid transparent;
    font-weight: 700;
    font-size: var(--t-body);
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    letter-spacing: -0.01em;
  }

  .bouton :global(svg) {
    width: 1.25em;
    height: 1.25em;
    flex: none;
  }

  .bouton--grand {
    font-size: 1.0625rem;
    padding: var(--e-4) var(--e-8);
    min-height: 56px;
  }

  .bouton--large {
    width: 100%;
  }

  .bouton--encre {
    background: var(--encre);
    color: var(--papier);
  }

  .bouton--encre:hover {
    background: #000;
    color: var(--papier);
  }

  .bouton--accent {
    background: var(--accent);
    color: var(--sur-accent);
  }

  .bouton--accent:hover {
    background: var(--accent-fonce);
    color: var(--sur-accent);
  }

  .bouton--contour {
    border-color: currentColor;
    color: var(--encre);
  }

  .bouton--contour:hover {
    background: var(--papier-2);
    color: var(--encre);
  }

  .bouton--lien {
    min-height: var(--touche);
    padding: var(--e-2) 0;
    color: var(--bleu);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }

  .bouton--lien:hover {
    color: var(--bleu-fonce);
  }

  @media (prefers-reduced-motion: no-preference) {
    .bouton:active {
      transform: translateY(1px);
    }
  }
</style>
